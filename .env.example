# Protótipo services/api. Chave do Gemini: só variável de servidor, nunca NEXT_PUBLIC_*/EXPO_PUBLIC_*.
GEMINI_API_KEY=coloque_sua_chave_aqui
# development | dev | local | test liberam a demo; qualquer outro valor (inclusive ausente) faz a API
# se recusar a subir com ENABLE_DEMO_ROUTES ligada, e desliga /docs e /openapi.json.
APP_ENV=development
# Rotas DEMO (custódia Pix, SOS, reputação FALSAS). Deixe desligado; ligue só no seu computador.
# Veja services/api/README.md. NUNCA em produção.
# ENABLE_DEMO_ROUTES=true
# Origens permitidas para chamar a API do navegador, separadas por vírgula. Vazio = nenhuma. "*" é recusado.
CORS_ALLOWED_ORIGINS=
DATABASE_URL=postgresql+asyncpg://workeasy_admin:<SUBSTITUA_PELA_SENHA_DO_ARQUIVO_.env>@localhost:5432/workeasy_prod
REDIS_URL=redis://localhost:6379/0
PIX_GATEWAY_API_URL=https://api.asaas.com/v3
PIX_GATEWAY_API_KEY=
PIX_WEBHOOK_SECRET=<SUBSTITUA_PELO_SEGREDO_DO_WEBHOOK>
EXPO_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
