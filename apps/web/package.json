{
  "name": "workeasy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:native": "vite --mode native",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "build:native": "tsc --noEmit && vite build --mode native",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:deno": "deno test --frozen --config supabase/functions/_test/deno.json --allow-read=.",
    "test:e2e-functions": "node scripts/e2e-functions.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check:store-bundle": "node scripts/check-store-bundle.mjs",
    "check:app-links": "node scripts/check-app-links.mjs",
    "db:seed": "node scripts/generate-seed.mjs",
    "db:types": "supabase gen types typescript > lib/database.types.ts",
    "db:test": "supabase test db",
    "cap:sync": "npm run build:native && cap sync",
    "android:build": "npm run build:native && cap sync android && cd android && ./gradlew assembleDebug",
    "ios:build": "npm run build:native && cap sync ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -sdk iphonesimulator -configuration Debug -derivedDataPath ios/build CODE_SIGNING_ALLOWED=NO build",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@sentry/react": "11.16.0",
    "@supabase/supabase-js": "2.119.2",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "supabase": "3.4.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  }
}
