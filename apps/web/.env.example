# Copy to .env.local for local development.
#
# Variables prefixed with VITE_ are embedded in the public JavaScript bundle
# and are visible to anyone who opens the app. Never put API keys, tokens or
# passwords in a VITE_ variable. Secrets belong in server-side functions
# (Supabase Edge Functions), configured with `supabase secrets set`.

# Router used by the build: "browser" for the website (default) or "hash"
# for the native shells (Capacitor and Tauri). The npm scripts set it.
VITE_ROUTER=browser

# Supabase project. Leave both empty to run the demo mode (fictitious data,
# no login, nothing stored). The publishable key (sb_publishable_...) is public
# by design: what each user can read or write is decided by Row Level Security
# in the database. Never use a secret key (sb_secret_...) here: the app accepts
# only the publishable key or the legacy anon key, and with any other key it
# stays in the demo mode (lib/supabaseKey.ts).
# Local stack: `npx supabase status` prints both values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# WhatsApp number of the concierge operation, digits only with country code
# (e.g. 5511999999999). Without a backend, /pedido builds a WhatsApp message
# to this number; empty = online requests are shown as not available yet.
VITE_CONCIERGE_WHATSAPP=

# Canonical site URL, used for SEO and for the links in login e-mails.
VITE_SITE_URL=

# Error reporting (Sentry). Empty = off: nothing is sent and the SDK is not loaded.
# The DSN is visible in the browser by design, so it is not a secret, but keep the real
# value out of the repository (set it in the hosting environment). Choose a project in the
# EU or the US region, as the owner decides.
VITE_SENTRY_DSN=

# Release name sent with an error report, e.g. the commit or a version tag. Empty = none.
VITE_APP_VERSION=

# Identification of the company, shown in the footer and on the legal pages of a
# build with a backend (online offers must show the supplier's corporate name,
# CNPJ, physical and electronic address: Decreto 7.962/2013, art. 2, I and II).
# Empty values are left out. Public information only.
VITE_COMPANY_NAME=
VITE_COMPANY_CNPJ=
VITE_COMPANY_ADDRESS=

# Customer service (SAC): e-mail, and WhatsApp as digits only with country code
# (e.g. 5511999999999).
VITE_SAC_EMAIL=
VITE_SAC_WHATSAPP=

# Status of the legal texts in content/legal/*.md. Leave empty while they are
# drafts under legal review (every legal page then shows that notice). Set to
# "vigente" only after a lawyer approved the published texts.
VITE_LEGAL_STATUS=
