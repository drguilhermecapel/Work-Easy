# Edge Functions secrets for local runs: copy to supabase/functions/.env (never commit it)
# and start with `supabase functions serve --env-file supabase/functions/.env`.
# In production, set them with `supabase secrets set NAME=value`.
# SUPABASE_URL, SUPABASE_ANON_KEY / SUPABASE_PUBLISHABLE_KEYS and
# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEYS are injected by Supabase.

# App origin allowed by CORS besides the native shells (capacitor/tauri), same value as VITE_SITE_URL
SITE_URL=
# true opens CORS to http://localhost:3000 (always on with the Asaas sandbox URL; never set it in production)
ALLOW_DEV_ORIGINS=

# Asaas (sandbox: https://api-sandbox.asaas.com/v3, production: https://api.asaas.com/v3)
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token Asaas sends in the asaas-access-token header (32 to 255 characters).
# Each provider subaccount gets its own token derived from this one: changing it means
# registering the webhook of every subaccount again.
ASAAS_WEBHOOK_TOKEN=
# Days a Pro provider with an overdue charge keeps the plan after the paid period (default 0, max 60)
PRO_GRACE_DAYS=

# WhatsApp Cloud API (empty = notifications marked "skipped")
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional, defaults to v26.0
WHATSAPP_GRAPH_VERSION=

# Resend (empty = e-mails marked "skipped")
RESEND_API_KEY=
EMAIL_FROM=

# Claude API for request-assist (empty = 503)
ANTHROPIC_API_KEY=
# request-assist calls per user per hour (default 10, 0 turns it off)
ASSIST_HOURLY_LIMIT=

# Secret sent by the scheduler to notify-dispatch (x-cron-secret header)
CRON_SECRET=
