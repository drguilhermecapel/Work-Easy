# Edge Functions secrets for local runs: copy to supabase/functions/.env (never commit it)
# and start with `supabase functions serve --env-file supabase/functions/.env`.
# In production, set them with `supabase secrets set NAME=value`.
# SUPABASE_URL, SUPABASE_ANON_KEY / SUPABASE_PUBLISHABLE_KEYS and
# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEYS are injected by Supabase.

# App origin allowed by CORS besides the native shells (capacitor/tauri), same value as VITE_SITE_URL
SITE_URL=
# production (also the default when SITE_URL is a public https origin), or development, staging, test.
# Any other value counts as production. In production the Asaas sandbox is refused and localhost is never allowed.
APP_ENV=
# true opens CORS to http://localhost:3000 outside production (the Asaas sandbox URL opens it too); ignored in production
ALLOW_DEV_ORIGINS=

# Asaas (sandbox: https://api-sandbox.asaas.com/v3, production: https://api.asaas.com/v3)
# Required in production, with no fallback: without it the payment functions answer 503. Development defaults to the sandbox.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token Asaas sends in the asaas-access-token header (32 to 255 characters).
# Each provider subaccount gets its own token derived from this one: changing it means
# registering the webhook of every subaccount again.
ASAAS_WEBHOOK_TOKEN=
# Fallback only. The days a Pro provider with an overdue charge keeps the plan come from
# platform_settings.pro_grace_days (the key the hourly expiry job reads). This variable is used
# when that key cannot be read (default 0, max 60).
PRO_GRACE_DAYS=

# WhatsApp Cloud API (empty = notifications marked "skipped")
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional, defaults to v26.0
WHATSAPP_GRAPH_VERSION=

# Resend (empty = e-mails marked "skipped")
RESEND_API_KEY=
EMAIL_FROM=

# Key of the CPF/CNPJ fingerprint for the free Pro trial (asaas-onboard, subscriptions-manage).
# Long random value, kept forever: changing it lets the same CPF take the trial again. Empty = trial off (503 trial_unavailable).
TRIAL_DOCUMENT_SECRET=

# Claude API for request-assist, quote-assist and care-summary (empty = 503)
ANTHROPIC_API_KEY=
# AI assist calls per user per hour, one counter shared by those three functions (default 10, 0 turns them off)
ASSIST_HOURLY_LIMIT=

# Secret sent by the scheduler to notify-dispatch (x-cron-secret header)
CRON_SECRET=

# Ordens de transporte O17. Configure cada projeto e conta separadamente, no backend.
# O ambiente de ensaio usa simulation; o de produção usa live.
RIDE_ORDER_ENVIRONMENT=
RIDE_ORDER_TEST_ENABLED=false
RIDE_ORDER_TEST_API_KEY=
RIDE_ORDER_TEST_WEBHOOK_TOKEN=
RIDE_ORDER_TEST_WITHDRAWALS_ENABLED=false
RIDE_ORDER_TEST_TRANSFER_TOKEN=
RIDE_ORDER_LIVE_ENABLED=false
RIDE_ORDER_LIVE_API_KEY=
RIDE_ORDER_LIVE_WEBHOOK_TOKEN=
RIDE_ORDER_LIVE_WITHDRAWALS_ENABLED=false
RIDE_ORDER_LIVE_TRANSFER_TOKEN=
# Segredo individual de carteira: RIDE_ORDER_{TEST|LIVE}_WALLET_<UUID_EM_MAIUSCULAS_SEM_TRACOS>
